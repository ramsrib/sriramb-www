---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import ProjectMeta from "@/components/ProjectMeta.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const projects = (await getCollection("projects"))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title={`Projects | ${config.site.title}`}
  description="Tools for working with AI agents — local-first, files on disk, no telemetry."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="Projects"
    pageDesc="Tools I build and use every day. Local-first, files on disk, no telemetry, no account."
  >
    <ul>
      {
        projects.map(({ id, data }) => (
          <li class="my-6">
            <a
              href={getRelativeLocaleUrl(locale, `projects/${id}`)}
              class:list={[
                "text-accent inline-block text-lg font-medium",
                "decoration-dashed underline-offset-4 hover:underline",
                "focus-visible:no-underline focus-visible:underline-offset-0",
              ]}
            >
              <h2>{data.title}</h2>
            </a>
            <ProjectMeta
              language={data.language}
              status={data.status}
              class="my-1"
            />
            <p>{data.tagline}</p>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
